// © Breakout/Retest Strategy v2.0 - Fixed Version

//@version=5
strategy("Breakout/Retest 2.0 Fixed", overlay=true, initial_capital=1000, 
         default_qty_type=strategy.percent_of_equity, default_qty_value=100, 
         pyramiding=0, slippage=3, commission_type=strategy.commission.percent, 
         commission_value=0.02)

// ============================================================
//                    INPUT PARAMETERS
// ============================================================
grp_fractals = "Fractal Settings"
left_bars  = input.int(5, title="Left Bars", group=grp_fractals, minval=1)
right_bars = input.int(5, title="Right Bars", group=grp_fractals, minval=1)

grp_rr = "Risk Management"
sl_buffer_pct = input.float(0.1, title="SL Buffer (%)", group=grp_rr, step=0.05) / 100
rr_ratio = input.float(2.0, title="Risk/Reward Ratio", group=grp_rr, step=0.1, minval=0.5, maxval=5.0)
use_trailing = input.bool(true, title="Use Trailing Stop", group=grp_rr)

grp_trend = "Trend Filter"
use_trend_filter = input.bool(true, title="Use Trend Filter", group=grp_trend)
ema_fast_len = input.int(21, title="Fast EMA Length", group=grp_trend)
ema_slow_len = input.int(50, title="Slow EMA Length", group=grp_trend)

grp_volume = "Volume Filter"
use_volume_filter = input.bool(true, title="Use Volume Filter", group=grp_volume)
vol_mult = input.float(1.2, title="Volume Multiplier", group=grp_volume, step=0.1)

grp_session = "Session Filter"
use_session_filter = input.bool(true, title="Use Session Filter", group=grp_session)
session_time = input.session("0900-1600", title="Trading Session", group=grp_session)

grp_retest = "Retest Settings"
retest_lookback = input.int(15, title="Max Bars for Retest", group=grp_retest)
retest_tolerance = input.float(0.3, title="Retest Zone Tolerance (%)", group=grp_retest, step=0.05) / 100

grp_visual = "Visual Settings"
show_signals = input.bool(true, title="Show Signal Labels", group=grp_visual)
show_levels = input.bool(true, title="Show S/R Levels", group=grp_visual)

// ============================================================
//                    INDICATOR CALCULATIONS
// ============================================================

// 1. Fractal Pivots (Support & Resistance)
pivot_high = ta.pivothigh(high, left_bars, right_bars)
pivot_low  = ta.pivotlow(low, left_bars, right_bars)

// 2. Trend Filter (EMA Crossover)
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
uptrend = ema_fast > ema_slow
trend_ok = use_trend_filter ? uptrend : true

// 3. Volume Filter
vol_sma = ta.sma(volume, 20)
vol_ok = use_volume_filter ? (volume > vol_sma * vol_mult) : true

// 4. Session Filter
in_session = not use_session_filter or time(timeframe.period, session_time)

// ============================================================
//                    STATE MANAGEMENT
// ============================================================

var float active_resistance = na
var float active_support = na
var float broken_resistance = na  // Store the resistance that was broken

// Update levels when new pivots form
if not na(pivot_high)
    active_resistance := pivot_high
    
if not na(pivot_low)
    active_support := pivot_low

// ============================================================
//                    BREAKOUT DETECTION
// ============================================================

var bool in_breakout = false
var int breakout_bar_idx = na

// Detect clean breakout (close above resistance)
breakout_occurred = not na(active_resistance) and close > active_resistance and close[1] <= active_resistance

// Track breakout state
if breakout_occurred and not in_breakout
    in_breakout := true
    breakout_bar_idx := bar_index
    broken_resistance := active_resistance  // Store the broken level

// Reset breakout state after timeout
if in_breakout and (bar_index - breakout_bar_idx > retest_lookback)
    in_breakout := false
    broken_resistance := na

// Reset if new resistance forms above current price
if not na(pivot_high) and in_breakout and pivot_high > close
    in_breakout := false
    broken_resistance := na

// ============================================================
//                    RETEST DETECTION
// ============================================================

// Use the broken resistance level for retest zone
retest_level = broken_resistance
retest_zone_upper = retest_level * (1 + retest_tolerance)
retest_zone_lower = retest_level * (1 - retest_tolerance)

// Check if price entered retest zone and bounced
in_retest_zone = in_breakout and not na(retest_level) and low <= retest_zone_upper and low >= retest_zone_lower

// Bullish bounce: price touched zone and closed above retest level with bullish candle
retest_bounce = in_retest_zone and close > open and close > retest_level

valid_retest_signal = in_breakout and retest_bounce

// ============================================================
//                    ENTRY CONDITIONS
// ============================================================

// Stage 1: Breakout Entry - place buy stop at resistance
long_breakout_setup = not in_breakout and 
                      not na(active_resistance) and 
                      not na(active_support) and
                      trend_ok and 
                      vol_ok and 
                      in_session

// Stage 2: Retest Entry - market order on confirmed retest
long_retest_signal = in_breakout and 
                     valid_retest_signal and
                     trend_ok and 
                     vol_ok and 
                     in_session

// ============================================================
//                    EXECUTION LOGIC
// ============================================================

// Track pending orders
var bool breakout_order_pending = false

// Cancel pending orders if conditions no longer valid
if strategy.position_size == 0
    if not long_breakout_setup
        strategy.cancel("Breakout")
        breakout_order_pending := false

// Place orders
if strategy.position_size == 0
    // STAGE 1: Breakout Entry (Buy Stop)
    if long_breakout_setup and not breakout_order_pending
        strategy.entry("Breakout", strategy.long, stop=active_resistance)
        breakout_order_pending := true
    
    // STAGE 2: Retest Entry (Market order on valid retest)
    if long_retest_signal
        strategy.entry("Retest", strategy.long)
        in_breakout := false  // Reset after entry
        broken_resistance := na

// Reset order pending flag if we enter breakout state
if in_breakout and breakout_order_pending
    breakout_order_pending := false

// ============================================================
//                    EXIT LOGIC
// ============================================================

var float trade_sl = na
var float trade_tp = na
var float trade_entry = na
var float highest_since_entry = na

// Set exits when position opens
if strategy.position_size > 0 and strategy.position_size[1] == 0
    trade_entry := strategy.position_avg_price
    highest_since_entry := high
    
    // Find stop loss level
    sl_level = na
    if not na(active_support) and active_support < trade_entry
        sl_level := active_support * (1 - sl_buffer_pct)
    else
        sl_level := trade_entry * (1 - 0.015)  // Fallback 1.5% below entry
    
    trade_sl := sl_level
    
    // Calculate risk and set TP
    risk_distance = trade_entry - trade_sl
    trade_tp := trade_entry + (risk_distance * rr_ratio)

// Track highest price since entry for trailing
if strategy.position_size > 0 and not na(trade_entry)
    highest_since_entry := math.max(highest_since_entry, high)

// Execute exits
if strategy.position_size > 0 and not na(trade_sl)
    // Calculate trailing stop if enabled and in profit
    trail_price = na
    if use_trailing and not na(highest_since_entry)
        risk_distance = trade_entry - trade_sl
        // Activate trail after 1R profit
        if highest_since_entry >= trade_entry + risk_distance
            trail_price := highest_since_entry - (risk_distance * 0.5)
    
    // Use the higher of original SL or trail price
    final_sl = not na(trail_price) ? math.max(trade_sl, trail_price) : trade_sl
    
    strategy.exit("Exit", stop=final_sl, limit=trade_tp, 
                  comment_loss="SL", comment_profit="TP")

// Reset trade variables when position closes
if strategy.position_size == 0 and strategy.position_size[1] != 0
    trade_sl := na
    trade_tp := na
    trade_entry := na
    highest_since_entry := na

// ============================================================
//                    VISUAL PLOTTING
// ============================================================

// Trend EMAs
plot(ema_fast, color=color.blue, title="Fast EMA", linewidth=1)
plot(ema_slow, color=color.orange, title="Slow EMA", linewidth=1)

// Support & Resistance Levels
plot(show_levels ? active_resistance : na, color=color.red, 
     style=plot.style_stepline, linewidth=2, title="Resistance")
plot(show_levels ? active_support : na, color=color.green, 
     style=plot.style_stepline, linewidth=2, title="Support")

// Broken Resistance (Retest Zone)
plot(show_levels and in_breakout ? broken_resistance : na, 
     color=color.fuchsia, style=plot.style_stepline, linewidth=2, title="Broken Resistance")
plot(show_levels and in_breakout ? retest_zone_upper : na, 
     color=color.new(color.blue, 60), style=plot.style_linebr, linewidth=1, title="Retest Upper")
plot(show_levels and in_breakout ? retest_zone_lower : na, 
     color=color.new(color.blue, 60), style=plot.style_linebr, linewidth=1, title="Retest Lower")

// Trade Levels when in position
plot(strategy.position_size > 0 ? trade_sl : na, color=color.red, 
     style=plot.style_linebr, linewidth=2, title="Stop Loss")
plot(strategy.position_size > 0 ? trade_tp : na, color=color.green, 
     style=plot.style_linebr, linewidth=2, title="Take Profit")

// Signal Labels
plotshape(show_signals and long_breakout_setup, title="Breakout Setup", 
          location=location.belowbar, color=color.blue, style=shape.labelup, 
          text="SETUP", textcolor=color.white)
          
plotshape(show_signals and long_retest_signal, title="Retest Signal", 
          location=location.belowbar, color=color.fuchsia, style=shape.labelup, 
          text="RETEST", textcolor=color.white)

plotshape(show_signals and strategy.position_size > 0 and strategy.position_size[1] == 0, 
          title="Entry", location=location.belowbar, color=color.lime, 
          style=shape.labelup, text="ENTRY", textcolor=color.black)

// Background for session
bgcolor(use_session_filter and in_session ? color.new(color.green, 95) : na, title="Session BG")

// ============================================================
//                    INFO TABLE
// ============================================================

var table info_table = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast
    table.cell(info_table, 0, 0, "Metric", bgcolor=color.gray, text_color=color.white)
    table.cell(info_table, 1, 0, "Value", bgcolor=color.gray, text_color=color.white)
    
    table.cell(info_table, 0, 1, "Trend", text_color=color.white)
    table.cell(info_table, 1, 1, uptrend ? "UP ↑" : "DOWN ↓", 
               bgcolor=uptrend ? color.green : color.red, text_color=color.white)
    
    table.cell(info_table, 0, 2, "Volume", text_color=color.white)
    table.cell(info_table, 1, 2, vol_ok ? "OK ✓" : "LOW ✗", 
               bgcolor=vol_ok ? color.green : color.red, text_color=color.white)
    
    table.cell(info_table, 0, 3, "Session", text_color=color.white)
    table.cell(info_table, 1, 3, in_session ? "OPEN ✓" : "CLOSED ✗", 
               bgcolor=in_session ? color.green : color.red, text_color=color.white)
    
    table.cell(info_table, 0, 4, "Breakout", text_color=color.white)
    table.cell(info_table, 1, 4, in_breakout ? "ACTIVE" : "NONE", 
               bgcolor=in_breakout ? color.blue : color.gray, text_color=color.white)
    
    table.cell(info_table, 0, 5, "R:R Ratio", text_color=color.white)
    table.cell(info_table, 1, 5, str.tostring(rr_ratio, "#.#") + ":1", 
               bgcolor=color.purple, text_color=color.white)
    
    table.cell(info_table, 0, 6, "Position", text_color=color.white)
    table.cell(info_table, 1, 6, strategy.position_size > 0 ? "LONG" : "FLAT", 
               bgcolor=strategy.position_size > 0 ? color.lime : color.gray, text_color=color.white)
