# Database
# For Vercel, use a hosted database provider (e.g. Neon, PlanetScale, Supabase)
# The app currently does not require a database to run (trading features use Binance REST API directly)
# DATABASE_URL="file:./db/dev.db"

# Telegram Bot (optional - for trading signal alerts)
# TELEGRAM_BOT_TOKEN="your-bot-token"
# TELEGRAM_CHAT_ID="your-chat-id"

# Next Auth (optional - if authentication is enabled)
# NEXTAUTH_SECRET="your-nextauth-secret"
# NEXTAUTH_URL="https://your-vercel-domain.vercel.app"
