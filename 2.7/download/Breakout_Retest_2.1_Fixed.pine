//@version=5
strategy("Breakout/Retest 2.1", overlay=true, initial_capital=1000, 
         default_qty_type=strategy.percent_of_equity, default_qty_value=100, 
         pyramiding=0, slippage=3, commission_type=strategy.commission.percent, 
         commission_value=0.02)

// ============================================================
//                    INPUT PARAMETERS
// ============================================================
grp_fractals = "Fractal Settings"
left_bars  = input.int(5, title="Left Bars", group=grp_fractals, minval=1)
right_bars = input.int(5, title="Right Bars", group=grp_fractals, minval=1)

grp_rr = "Risk Management"
sl_buffer_pct = input.float(0.1, title="SL Buffer (%)", group=grp_rr, step=0.05) / 100
rr_ratio = input.float(2.0, title="Risk/Reward Ratio", group=grp_rr, step=0.1, minval=0.5, maxval=5.0)
trail_after_r = input.float(1.0, title="Trail After R Profit", group=grp_rr, step=0.1)
trail_pct = input.float(0.5, title="Trail Distance (% of R)", group=grp_rr, step=0.1)

grp_trend = "Trend Filter"
use_trend_filter = input.bool(true, title="Use Trend Filter", group=grp_trend)
ema_fast_len = input.int(21, title="Fast EMA Length", group=grp_trend)
ema_slow_len = input.int(50, title="Slow EMA Length", group=grp_trend)

grp_volume = "Volume Filter"
use_volume_filter = input.bool(true, title="Use Volume Filter", group=grp_volume)
vol_mult = input.float(1.2, title="Volume Multiplier", group=grp_volume, step=0.1)

grp_session = "Session Filter"
use_session_filter = input.bool(true, title="Use Session Filter", group=grp_session)
session_time = input.session("0900-1600", title="Trading Session", group=grp_session)

grp_retest = "Retest Settings"
retest_lookback = input.int(15, title="Max Bars for Retest", group=grp_retest)
retest_tolerance = input.float(0.3, title="Retest Zone Tolerance (%)", group=grp_retest, step=0.05) / 100

grp_visual = "Visual Settings"
show_signals = input.bool(true, title="Show Signal Labels", group=grp_visual)
show_levels = input.bool(true, title="Show S/R Levels", group=grp_visual)

// ============================================================
//                    INDICATOR CALCULATIONS
// ============================================================

// Fractal Pivots
pivot_high = ta.pivothigh(high, left_bars, right_bars)
pivot_low  = ta.pivotlow(low, left_bars, right_bars)

// Trend Filter
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
uptrend = ema_fast > ema_slow
trend_ok = use_trend_filter ? uptrend : true

// Volume Filter
vol_sma = ta.sma(volume, 20)
vol_ok = use_volume_filter ? (volume > vol_sma * vol_mult) : true

// Session Filter
in_session = not use_session_filter or time(timeframe.period, session_time)

// ============================================================
//                    STATE MANAGEMENT
// ============================================================

var float active_resistance = na
var float active_support = na
var float broken_level = na
var bool waiting_retest = false
var int breakout_bar = na

// Update levels when new pivots form
if not na(pivot_high)
    active_resistance := pivot_high
    
if not na(pivot_low)
    active_support := pivot_low

// ============================================================
//                    BREAKOUT & RETEST LOGIC
// ============================================================

// Detect breakout: close above resistance
breakout_now = not na(active_resistance) and close > active_resistance and close[1] <= active_resistance

// Set breakout state
if breakout_now and not waiting_retest
    waiting_retest := true
    broken_level := active_resistance
    breakout_bar := bar_index

// Timeout: reset if too many bars pass
if waiting_retest and not na(breakout_bar)
    if bar_index - breakout_bar > retest_lookback
        waiting_retest := false
        broken_level := na
        breakout_bar := na

// Retest zone calculation
retest_upper = not na(broken_level) ? broken_level * (1 + retest_tolerance) : na
retest_lower = not na(broken_level) ? broken_level * (1 - retest_tolerance) : na

// Detect retest: price touches zone and bounces
in_zone = waiting_retest and not na(broken_level) and low <= retest_upper and low >= retest_lower
bullish_bounce = in_zone and close > open and close > broken_level
retest_signal = waiting_retest and bullish_bounce

// ============================================================
//                    ENTRY CONDITIONS
// ============================================================

// Breakout entry: buy stop at resistance (before breakout)
breakout_entry = not waiting_retest and 
                 not na(active_resistance) and 
                 not na(active_support) and
                 close < active_resistance and
                 trend_ok and vol_ok and in_session

// Retest entry: market order on bounce confirmation
retest_entry = retest_signal and trend_ok and vol_ok and in_session

// ============================================================
//                    EXECUTION
// ============================================================

if strategy.position_size == 0
    // Breakout entry
    if breakout_entry
        strategy.entry("Breakout", strategy.long, stop=active_resistance)
    
    // Retest entry
    if retest_entry
        strategy.entry("Retest", strategy.long)
        waiting_retest := false
        broken_level := na
        breakout_bar := na

// ============================================================
//                    EXIT LOGIC
// ============================================================

var float entry_price = na
var float sl_price = na
var float tp_price = na
var float risk = na
var float trail_active = na

// Calculate exits on entry
if strategy.position_size > 0 and strategy.position_size[1] == 0
    entry_price := strategy.position_avg_price
    
    // Set stop loss at support
    if not na(active_support) and active_support < entry_price
        sl_price := active_support * (1 - sl_buffer_pct)
    else
        sl_price := entry_price * 0.98  // 2% default
    
    risk := entry_price - sl_price
    tp_price := entry_price + (risk * rr_ratio)
    trail_active := na

// Update trailing stop
if strategy.position_size > 0 and not na(entry_price) and not na(risk)
    // Check if we hit trail activation level
    trail_trigger = entry_price + (risk * trail_after_r)
    if high >= trail_trigger and na(trail_active)
        trail_active := sl_price  // Lock in breakeven minimum

// Execute exit
if strategy.position_size > 0 and not na(sl_price)
    // Calculate trailing stop if active
    final_sl = sl_price
    if not na(trail_active)
        trail_distance = risk * trail_pct
        new_trail = high - trail_distance
        trail_active := math.max(trail_active, new_trail)
        final_sl := math.max(sl_price, trail_active)
    
    strategy.exit("Exit", stop=final_sl, limit=tp_price)

// Reset on position close
if strategy.position_size == 0 and strategy.position_size[1] != 0
    entry_price := na
    sl_price := na
    tp_price := na
    risk := na
    trail_active := na

// ============================================================
//                    VISUAL PLOTTING
// ============================================================

plot(ema_fast, color=color.blue, title="Fast EMA", linewidth=1)
plot(ema_slow, color=color.orange, title="Slow EMA", linewidth=1)

plot(show_levels ? active_resistance : na, color=color.red, style=plot.style_stepline, linewidth=2, title="Resistance")
plot(show_levels ? active_support : na, color=color.green, style=plot.style_stepline, linewidth=2, title="Support")
plot(show_levels and waiting_retest ? broken_level : na, color=color.fuchsia, style=plot.style_stepline, linewidth=2, title="Broken Level")
plot(show_levels and waiting_retest ? retest_upper : na, color=color.new(color.blue, 70), style=plot.style_linebr, linewidth=1)
plot(show_levels and waiting_retest ? retest_lower : na, color=color.new(color.blue, 70), style=plot.style_linebr, linewidth=1)

plot(strategy.position_size > 0 ? sl_price : na, color=color.red, style=plot.style_linebr, linewidth=2, title="SL")
plot(strategy.position_size > 0 ? tp_price : na, color=color.green, style=plot.style_linebr, linewidth=2, title="TP")

plotshape(show_signals and breakout_entry, location=location.belowbar, color=color.blue, style=shape.labelup, text="SETUP", textcolor=color.white, title="Setup")
plotshape(show_signals and retest_entry, location=location.belowbar, color=color.fuchsia, style=shape.labelup, text="RETEST", textcolor=color.white, title="Retest")
plotshape(show_signals and strategy.position_size > 0 and strategy.position_size[1] == 0, location=location.belowbar, color=color.lime, style=shape.labelup, text="ENTRY", textcolor=color.black, title="Entry")

bgcolor(use_session_filter and in_session ? color.new(color.green, 95) : na)

// Info Table
var table t = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "Status", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 1, 0, "Value", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 0, 1, "Trend", text_color=color.white)
    table.cell(t, 1, 1, uptrend ? "UP" : "DOWN", bgcolor=uptrend ? color.green : color.red, text_color=color.white)
    table.cell(t, 0, 2, "Volume", text_color=color.white)
    table.cell(t, 1, 2, vol_ok ? "OK" : "LOW", bgcolor=vol_ok ? color.green : color.red, text_color=color.white)
    table.cell(t, 0, 3, "Session", text_color=color.white)
    table.cell(t, 1, 3, in_session ? "OPEN" : "CLOSED", bgcolor=in_session ? color.green : color.red, text_color=color.white)
    table.cell(t, 0, 4, "Retest", text_color=color.white)
    table.cell(t, 1, 4, waiting_retest ? "WAITING" : "NONE", bgcolor=waiting_retest ? color.blue : color.gray, text_color=color.white)
    table.cell(t, 0, 5, "R:R", text_color=color.white)
    table.cell(t, 1, 5, str.tostring(rr_ratio, "#.#") + ":1", bgcolor=color.purple, text_color=color.white)
